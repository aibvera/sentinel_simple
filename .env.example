# Copia este archivo como .env y ajusta los valores.
# (Sin comillas ni comentarios al final de línea: así lo entienden tanto python-dotenv como `docker --env-file`.)

# --- Cámara ---
RTSP_URL=rtsp://usuario:clave@192.168.1.40:554/stream1
# tcp es más estable; udp tiene menos latencia
RTSP_TRANSPORT=tcp

# --- Detección de movimiento ---
# % de píxeles distintos al frame anterior para considerar que hay movimiento
DISIMIL_TH=0.5
# Diferencia de intensidad (0-255) para considerar que un píxel cambió
PIXEL_DIFF_TH=25

# --- Grabación ---
# Carpeta de videos (en Docker se sobreescribe con -e SAVE_PATH=/recordings)
SAVE_PATH=recordings
# Segundos grabados antes y después del movimiento
PRE_RECORD_SECONDS=2
POST_RECORD_SECONDS=5
# Duración máxima de un clip; los eventos largos se parten en varios archivos
MAX_CLIP_SECONDS=300
# Calidad H.264: menor CRF = más calidad y más peso (18-30 razonable)
VIDEO_CRF=26
VIDEO_PRESET=veryfast

# --- Almacenamiento ---
# Días que se conservan los videos antes de borrarse automáticamente
ELIMINATION_DAYS=7
# Si el disco baja de este espacio libre, se borran los videos más antiguos (0 = desactivado)
MIN_FREE_MB=1024
CLEANUP_INTERVAL_MINUTES=10

# --- Sistema ---
# Zona horaria para nombrar carpetas y archivos (vacío = hora local del sistema)
TIMEZONE=America/Bogota
LOG_LEVEL=INFO
